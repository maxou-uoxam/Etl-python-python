# ETL Manager configuration
# Copy this file to .env and adjust values

# Application
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database (SQLite by default, no changes needed)
# DATABASE_URL=sqlite:///./etl_manager.db

# Projects directory (where YAML files are stored)
# PROJECTS_DIR=./projects

# Security — CHANGE IN PRODUCTION
SECRET_KEY=change-me-in-production-etl-secret-key
CONNECTION_ENCRYPTION_KEY=etl-manager-fernet-key-change-in-prod

# SQL Server driver (check your installed ODBC drivers)
# SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
